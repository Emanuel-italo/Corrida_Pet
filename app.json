{
  "expo": {
    "name": "Corrida Pet",
    "slug": "Corrida_Pet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Precisamos da sua localização para acompanhar sua corrida/caminhada e conquistar território no mapa."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.Corrida_Pet"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Precisamos da sua localização para acompanhar sua corrida/caminhada e conquistar território no mapa."
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Precisamos acessar suas fotos para escolher a foto do seu pet.",
          "cameraPermission": "Precisamos da câmera para tirar uma foto do seu pet."
        }
      ]
    ]
  }
}
